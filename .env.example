# SentinelStack Development Environment Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=sentinelstack
POSTGRES_PASSWORD=dev_password_123
POSTGRES_DB=sentinelstack
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Connection string for the application
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=sentinelstack;Username=sentinelstack;Password=dev_password_123

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET=your-256-bit-secret-key-change-in-production-minimum-32-chars
JWT_ISSUER=sentinelstack
JWT_AUDIENCE=sentinelstack-api
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# =============================================================================
# AWS Configuration (for SES email)
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# Application Settings
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Logging
LOG_LEVEL=Debug
SERILOG_MINIMUM_LEVEL=Debug

# =============================================================================
# Hangfire
# =============================================================================
HANGFIRE_DASHBOARD_ENABLED=true
HANGFIRE_DASHBOARD_USERNAME=admin
HANGFIRE_DASHBOARD_PASSWORD=admin

# =============================================================================
# Feature Flags (Alpha)
# =============================================================================
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_SLACK_INTEGRATION=false
FEATURE_SMS_NOTIFICATIONS=false
